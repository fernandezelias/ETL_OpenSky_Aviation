# ==========================================================
# ETL_OpenSky_Aviation - .gitignore
# ==========================================================

# --- Data Lake (mantener carpetas vacías en repo, ignorar contenido) ---
data/etl_datalake/*

# Pero permitir que se vean las carpetas internas sin datos:
!data/etl_datalake/.gitkeep
!data/etl_datalake/bronze/.gitkeep
!data/etl_datalake/silver/.gitkeep
!data/etl_datalake/gold/.gitkeep
!data/etl_datalake/exports/.gitkeep

# --- Delta Lake logs ---
**/_delta_log/

# --- Prefect checkpoints ---
checkpoints/

# --- Python cache ---
__pycache__/
*.pyc

# --- Jupyter ---
.ipynb_checkpoints/

# --- Local configuration ---
pipeline.conf

# --- Local environments ---
.venv/
.env/

# --- Logs ---
logs/
*.log

# --- OS-specific ---
.DS_Store
Thumbs.db