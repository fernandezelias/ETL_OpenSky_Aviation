# ==========================================================
# ETL_OpenSky_Aviation - .gitignore (Versión Final Optimizada)
# ==========================================================

# ==========================================================
# Data Lake — ignorar contenido, mantener estructura (LOCAL)
# ==========================================================

# Ignorar archivos dentro de ambos Data Lakes (local),
# pero permitir que Git vea las carpetas internas
local/data/etl_datalake/*
local/data/etl_datalake_manual/*

# Permitir que Git recorra todas las subcarpetas
!local/data/etl_datalake/**/
!local/data/etl_datalake_manual/**/

# Permitir carpeta raíz de data (local)
!local/data/.gitkeep

# ----------------------------------------------------------
# .gitkeep permitidos para versionar la estructura del
# Data Lake ORQUESTADO (etl_datalake)
# ----------------------------------------------------------

!local/data/etl_datalake/.gitkeep
!local/data/etl_datalake/bronze/.gitkeep
!local/data/etl_datalake/bronze/api_opensky/.gitkeep
!local/data/etl_datalake/bronze/api_opensky/states/.gitkeep
!local/data/etl_datalake/bronze/api_opensky/aircraft_metadata/.gitkeep

!local/data/etl_datalake/silver/.gitkeep
!local/data/etl_datalake/silver/api_opensky/.gitkeep
!local/data/etl_datalake/silver/api_opensky/states/.gitkeep
!local/data/etl_datalake/silver/api_opensky/aircraft_metadata/.gitkeep

!local/data/etl_datalake/gold/.gitkeep
!local/data/etl_datalake/gold/api_opensky/.gitkeep

# ----------------------------------------------------------
# .gitkeep permitidos para versionar la estructura del
# Data Lake MANUAL (etl_datalake_manual)
# ----------------------------------------------------------

!local/data/etl_datalake_manual/.gitkeep
!local/data/etl_datalake_manual/bronze/.gitkeep
!local/data/etl_datalake_manual/bronze/api_opensky/.gitkeep
!local/data/etl_datalake_manual/bronze/api_opensky/states/.gitkeep
!local/data/etl_datalake_manual/bronze/api_opensky/aircraft_metadata/.gitkeep

!local/data/etl_datalake_manual/silver/.gitkeep
!local/data/etl_datalake_manual/silver/api_opensky/.gitkeep
!local/data/etl_datalake_manual/silver/api_opensky/states/.gitkeep
!local/data/etl_datalake_manual/silver/api_opensky/aircraft_metadata/.gitkeep

!local/data/etl_datalake_manual/gold/.gitkeep
!local/data/etl_datalake_manual/gold/api_opensky/.gitkeep

!local/data/etl_datalake_manual/exports/.gitkeep

# ----------------------------------------------------------
# Ignorar logs internos de Delta Lake siempre
# ----------------------------------------------------------
local/data/**/_delta_log/

# ==========================================================
# Prefect checkpoints
# ==========================================================
checkpoints/

# ==========================================================
# Python cache
# ==========================================================
__pycache__/
*.pyc

# ==========================================================
# Jupyter
# ==========================================================
.ipynb_checkpoints/

# ==========================================================
# Config local (no subir credenciales)
# ==========================================================
pipeline.conf

# ==========================================================
# Entornos locales
# ==========================================================
.venv/
.env/

# ==========================================================
# Logs locales
# ==========================================================
logs/
*.log

# ==========================================================
# OS-specific
# ==========================================================
.DS_Store
Thumbs.db