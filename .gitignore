# ==========================================================
# ETL_OpenSky_Aviation - .gitignore (Versión Final Optimizada)
# ==========================================================

# ==========================================================
# Data Lake — ignorar contenido, mantener estructura
# ==========================================================

# Ignorar TODO dentro de ambos Data Lakes
data/etl_datalake/**
data/etl_datalake_manual/**

# Permitir que la carpeta raíz 'data/' exista en el repositorio
!data/.gitkeep

# ----------------------------------------------------------
# .gitkeep permitidos para versionar la estructura del
# Data Lake ORQUESTADO (etl_datalake)
# ----------------------------------------------------------

!data/etl_datalake/.gitkeep
!data/etl_datalake/bronze/.gitkeep
!data/etl_datalake/bronze/api_opensky/.gitkeep
!data/etl_datalake/bronze/api_opensky/states/.gitkeep
!data/etl_datalake/bronze/api_opensky/aircraft_metadata/.gitkeep

!data/etl_datalake/silver/.gitkeep
!data/etl_datalake/silver/api_opensky/.gitkeep
!data/etl_datalake/silver/api_opensky/states/.gitkeep
!data/etl_datalake/silver/api_opensky/aircraft_metadata/.gitkeep

!data/etl_datalake/gold/.gitkeep
!data/etl_datalake/gold/api_opensky/.gitkeep

# ----------------------------------------------------------
# .gitkeep permitidos para versionar la estructura del
# Data Lake MANUAL (etl_datalake_manual)
# ----------------------------------------------------------

!data/etl_datalake_manual/.gitkeep
!data/etl_datalake_manual/bronze/.gitkeep
!data/etl_datalake_manual/bronze/api_opensky/.gitkeep
!data/etl_datalake_manual/bronze/api_opensky/states/.gitkeep
!data/etl_datalake_manual/bronze/api_opensky/aircraft_metadata/.gitkeep

!data/etl_datalake_manual/silver/.gitkeep
!data/etl_datalake_manual/silver/api_opensky/.gitkeep
!data/etl_datalake_manual/silver/api_opensky/states/.gitkeep
!data/etl_datalake_manual/silver/api_opensky/aircraft_metadata/.gitkeep

!data/etl_datalake_manual/gold/.gitkeep
!data/etl_datalake_manual/gold/api_opensky/.gitkeep

!data/etl_datalake_manual/exports/.gitkeep

# ----------------------------------------------------------
# Ignorar logs internos de Delta Lake siempre
# ----------------------------------------------------------
data/**/_delta_log/

# ==========================================================
# Prefect checkpoints
# ==========================================================
checkpoints/

# ==========================================================
# Python cache
# ==========================================================
__pycache__/
*.pyc

# ==========================================================
# Jupyter
# ==========================================================
.ipynb_checkpoints/

# ==========================================================
# Config local (no subir credenciales)
# ==========================================================
pipeline.conf

# ==========================================================
# Entornos locales
# ==========================================================
.venv/
.env/

# ==========================================================
# Logs locales
# ==========================================================
logs/
*.log

# ==========================================================
# OS-specific
# ==========================================================
.DS_Store
Thumbs.db