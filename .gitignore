# ==========================================================
# ETL_OpenSky_Aviation - .gitignore (Versión Final Optimizada)
# ==========================================================

# ==========================================================
# Data Lake — ignorar contenido, mantener estructura
# ==========================================================

# Ignorar TODO dentro del Data Lake
data/etl_datalake/**

# Permitir únicamente .gitkeep para versionar estructura
!data/etl_datalake/.gitkeep
!data/etl_datalake/bronze/.gitkeep
!data/etl_datalake/bronze/api_opensky/.gitkeep
!data/etl_datalake/bronze/api_opensky/states/.gitkeep
!data/etl_datalake/bronze/api_opensky/aircraft_metadata/.gitkeep

!data/etl_datalake/silver/.gitkeep
!data/etl_datalake/silver/api_opensky/.gitkeep
!data/etl_datalake/silver/api_opensky/states/.gitkeep
!data/etl_datalake/silver/api_opensky/aircraft_metadata/.gitkeep

!data/etl_datalake/gold/.gitkeep
!data/etl_datalake/gold/api_opensky/.gitkeep

!data/etl_datalake/exports/.gitkeep

# Ignorar logs internos de Delta Lake siempre
data/etl_datalake/**/_delta_log/

# ==========================================================
# Prefect checkpoints
# ==========================================================
checkpoints/

# ==========================================================
# Python cache
# ==========================================================
__pycache__/
*.pyc

# ==========================================================
# Jupyter
# ==========================================================
.ipynb_checkpoints/

# ==========================================================
# Config local (no subir credenciales)
# ==========================================================
pipeline.conf

# ==========================================================
# Entornos locales
# ==========================================================
.venv/
.env/

# ==========================================================
# Logs locales
# ==========================================================
logs/
*.log

# ==========================================================
# OS-specific
# ==========================================================
.DS_Store
Thumbs.db